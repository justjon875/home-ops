.:53 {
    bind 127.0.0.2
    rewrite stop type AAAA A
    errors
    health :8081 {
        lameduck 5s
    }
    log {
        class error
    }
    forward . tls://9.9.9.9 tls://149.112.112.112
 {
        tls_servername dns.quad9.net
        policy sequential
        health_check 5s
    }
    reload
}

cluster.local:53 {
    bind 127.0.0.2
    rewrite stop type AAAA A
    errors
    log {
        class error
    }
    forward . 10.96.0.10
}

${ROOT_DOMAIN}:53 {
    bind 127.0.0.2
    rewrite stop type AAAA A
    errors
    log {
        class error
    }
    forward . 172.16.0.53
}
